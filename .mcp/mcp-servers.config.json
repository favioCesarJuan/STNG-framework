{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "priority": "MANDATORY",
      "description": "Live library and SDK documentation lookup."
    },
    "codebase-memory-mcp": {
      "command": "npx",
      "args": ["-y", "codebase-memory-mcp"],
      "priority": "MANDATORY",
      "description": "Persistent AST knowledge graph and call-chain tracing."
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "priority": "HIGH",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "description": "Repository, PR, and issue automation."
    }
  }
}
