{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "framework": "stng-governance-core",
  "description": "Multi-Provider Model Matrix with Execution Parameters and Role Mapping",
  "providers": {
    "gemini": {
      "name": "Google Gemini",
      "envKey": "GEMINI_API_KEY",
      "orchestratorModel": "gemini-2.5-pro",
      "mechanicModel": "gemini-2.5-flash",
      "reasoningEffort": "high",
      "contextWindow": 1048576,
      "temperature": {
        "reasoning": 0.2,
        "creative": 0.7,
        "mechanical": 0.0
      },
      "roles": {
        "lead-orchestrator": "gemini-2.5-pro",
        "systems-logic-analyst": "gemini-2.5-pro",
        "architecture-lead": "gemini-2.5-pro",
        "meta-critic-evaluator": "gemini-2.5-pro",
        "security-guardrail": "gemini-2.5-flash",
        "quality-health-auditor": "gemini-2.5-flash",
        "ux-design-enforcer": "gemini-2.5-flash",
        "test-automation-runner": "gemini-2.5-flash"
      }
    },
    "claude": {
      "name": "Anthropic Claude",
      "envKey": "ANTHROPIC_API_KEY",
      "orchestratorModel": "claude-3-7-sonnet",
      "mechanicModel": "claude-3-5-haiku",
      "reasoningEffort": "extended_thinking",
      "contextWindow": 200000,
      "temperature": {
        "reasoning": 0.2,
        "creative": 0.7,
        "mechanical": 0.0
      },
      "roles": {
        "lead-orchestrator": "claude-3-7-sonnet",
        "systems-logic-analyst": "claude-3-7-sonnet",
        "architecture-lead": "claude-3-7-sonnet",
        "meta-critic-evaluator": "claude-3-7-sonnet",
        "security-guardrail": "claude-3-5-haiku",
        "quality-health-auditor": "claude-3-5-haiku",
        "ux-design-enforcer": "claude-3-5-haiku",
        "test-automation-runner": "claude-3-5-haiku"
      }
    },
    "openai": {
      "name": "OpenAI",
      "envKey": "OPENAI_API_KEY",
      "orchestratorModel": "gpt-4o",
      "mechanicModel": "gpt-4o-mini",
      "reasoningEffort": "medium",
      "contextWindow": 128000,
      "temperature": {
        "reasoning": 0.1,
        "creative": 0.7,
        "mechanical": 0.0
      },
      "roles": {
        "lead-orchestrator": "gpt-4o",
        "systems-logic-analyst": "o3-mini",
        "architecture-lead": "gpt-4o",
        "meta-critic-evaluator": "o3-mini",
        "security-guardrail": "gpt-4o-mini",
        "quality-health-auditor": "gpt-4o-mini",
        "ux-design-enforcer": "gpt-4o-mini",
        "test-automation-runner": "gpt-4o-mini"
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "envKey": "DEEPSEEK_API_KEY",
      "orchestratorModel": "deepseek-reasoner",
      "mechanicModel": "deepseek-chat",
      "reasoningEffort": "high",
      "contextWindow": 64000,
      "temperature": {
        "reasoning": 0.0,
        "creative": 0.6,
        "mechanical": 0.0
      },
      "roles": {
        "lead-orchestrator": "deepseek-reasoner",
        "systems-logic-analyst": "deepseek-reasoner",
        "architecture-lead": "deepseek-reasoner",
        "meta-critic-evaluator": "deepseek-reasoner",
        "security-guardrail": "deepseek-chat",
        "quality-health-auditor": "deepseek-chat",
        "ux-design-enforcer": "deepseek-chat",
        "test-automation-runner": "deepseek-chat"
      }
    },
    "ollama": {
      "name": "Local Ollama / Air-Gapped",
      "envKey": "OLLAMA_HOST",
      "orchestratorModel": "qwen2.5-coder:32b",
      "mechanicModel": "qwen2.5-coder:7b",
      "reasoningEffort": "standard",
      "contextWindow": 32768,
      "quarantineSubagents": true,
      "temperature": {
        "reasoning": 0.1,
        "creative": 0.7,
        "mechanical": 0.0
      },
      "roles": {
        "lead-orchestrator": "qwen2.5-coder:32b",
        "systems-logic-analyst": "deepseek-r1:8b",
        "architecture-lead": "qwen2.5-coder:32b",
        "meta-critic-evaluator": "deepseek-r1:8b",
        "security-guardrail": "qwen2.5-coder:7b",
        "quality-health-auditor": "qwen2.5-coder:7b",
        "ux-design-enforcer": "qwen2.5-coder:7b",
        "test-automation-runner": "qwen2.5-coder:7b"
      }
    }
  }
}
