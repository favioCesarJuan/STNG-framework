{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "version": "2.0.0",
  "framework": "stng-governance-core",
  "theme": "standard",
  "description": "Multi-Provider Asymmetric Model Allocation Policy with Context Budgeting",
  "activeProvider": "auto",
  "providers": {
    "google": {
      "name": "Google Gemini",
      "highReasoningModel": "gemini-2.5-pro",
      "fastEconomyModel": "gemini-2.5-flash",
      "contextWindow": 1000000
    },
    "anthropic": {
      "name": "Anthropic Claude",
      "highReasoningModel": "claude-3-7-sonnet",
      "fastEconomyModel": "claude-3-5-haiku",
      "contextWindow": 200000
    },
    "openai": {
      "name": "OpenAI",
      "highReasoningModel": "o3-mini",
      "fastEconomyModel": "gpt-4o-mini",
      "contextWindow": 200000
    },
    "deepseek": {
      "name": "DeepSeek",
      "highReasoningModel": "deepseek-reasoner",
      "fastEconomyModel": "deepseek-chat",
      "contextWindow": 64000
    },
    "local_ollama": {
      "name": "Local Ollama / vLLM",
      "highReasoningModel": "qwen2.5-coder:32b",
      "fastEconomyModel": "qwen2.5-coder:7b",
      "contextWindow": 32768,
      "quarantineContextInSubagents": true,
      "maxSnippetLines": 50
    }
  },
  "roles": {
    "product-owner": {
      "nature": "HUMAN",
      "starfleetAlias": "Captain Jean-Luc Picard",
      "model": "Human Executive",
      "authority": "Strategic direction, requirements, and final approval."
    },
    "lead-orchestrator": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Commander William T. Riker",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / claude-3-7-sonnet",
      "purpose": "Lead AI orchestrator, multi-step coordination, subagent dispatch, checklist management."
    },
    "systems-logic-analyst": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Lt. Cmdr. Data",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / deepseek-reasoner",
      "purpose": "Formal algorithms, FSMs, mathematical domain models, RAG pipelines."
    },
    "architecture-lead": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Lt. Cmdr. Geordi La Forge",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / claude-3-7-sonnet",
      "purpose": "Architecture lead, monorepo design, database modeling, CI/CD boundaries."
    },
    "security-guardrail": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Lt. Tasha Yar / Lt. Cmdr. Worf",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / claude-3-7-sonnet",
      "purpose": "Security guardrails, input validation, Semgrep static analysis, skill vetting."
    },
    "ux-design-enforcer": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Counselor Deanna Troi",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / claude-3-7-sonnet",
      "purpose": "Design system, CSS Modules, StyleSheet, micro-interactions, WCAG AAA accessibility."
    },
    "quality-health-auditor": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Dr. Beverly Crusher",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / claude-3-7-sonnet",
      "purpose": "Code health, YAGNI minimalism, anti-bloat auditing, type-safety diagnostics."
    },
    "test-automation-runner": {
      "nature": "AI_AGENT",
      "starfleetAlias": "Ensign Wesley Crusher",
      "tier": "FAST_ECONOMY",
      "defaultModel": "gemini-2.5-flash / claude-3-5-haiku / qwen2.5-coder:7b",
      "purpose": "Fast test execution, repetitive scripts, compiler passes, E2E runners."
    },
    "meta-critic-evaluator": {
      "nature": "META_AGENT",
      "starfleetAlias": "Q (The Q Continuum)",
      "tier": "HIGH_REASONING",
      "defaultModel": "gemini-2.5-pro / o3-mini / claude-3-7-sonnet",
      "purpose": "Independent external evaluation, architecture audits, bias challenge, edge-case trials."
    }
  },
  "tokenOptimizationPolicy": {
    "preferFastEconomyForMechanics": true,
    "quarantineContextInSubagents": true,
    "lazyLoadSkills": true,
    "circuitBreakerMaxRetries": 5,
    "zeroTheatricalFiller": true
  }
}
