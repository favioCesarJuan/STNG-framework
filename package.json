{
  "name": "stng-framework",
  "version": "2.1.0",
  "description": "Structured Tactical Node Governance (STNG) — Deterministic Agent Governance Runtime: pre-tool shell & path guards, edit circuit breakers, post-edit policy checks, skill security scanning, and monorepo cascade scoping.",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "scripts": {
    "init": "node ./bin/stng.js init",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "demo": "node ./examples/quickstart-demo.js",
    "guard:shell": "node .agents/hooks/pre-tool-shell-guard.js --test",
    "guard:node": "node scripts/node-runtime-cve-check.js --test",
    "guard:sast": "semgrep scan --config .semgrep.yml --disable-version-check --metrics=off .",
    "guard:skills": "node .agents/hooks/skill-security-scanner.js --test",
    "guard:all": "pnpm run guard:shell && pnpm run guard:node && pnpm run guard:sast && pnpm run guard:skills",
    "policy:check": "node .agents/hooks/post-edit-policy-check.js --test",
    "graph:cascade": "node .agents/hooks/monorepo-cascade-scope.js --test",
    "audit:stats": "node ./bin/stng.js audit-stats",
    "circuit:reset": "node .agents/hooks/edit-circuit-breaker.js --reset",
    "pre-commit": "bash scripts/pre-commit.sh",
    "shield:test": "pnpm run guard:shell",
    "shield:all": "pnpm run guard:all",
    "health:check": "pnpm run policy:check",
    "log:stats": "pnpm run audit:stats"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "model-hooks",
    "deterministic-guardrails",
    "agent-governance",
    "monorepo-governance",
    "security-guardrails",
    "semgrep"
  ],
  "author": "Favio Cesar Juan <faviocjuan@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "stng": "./bin/stng.js",
    "stng-framework": "./bin/stng.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
