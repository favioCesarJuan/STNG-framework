#!/usr/bin/env bash
# ==============================================================================
# 🛡️ STNG-FRAMEWORK: DETERMINISTIC GIT PRE-COMMIT SHIELD
# ==============================================================================
# Bound via `git config core.hooksPath .agents/git-hooks`
# Enforces Starfleet security, Semgrep SAST, Node CVE baselines, and health.
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -f "$ROOT_DIR/scripts/pre-commit.sh" ]; then
  bash "$ROOT_DIR/scripts/pre-commit.sh"
else
  node "$ROOT_DIR/.agents/hooks/worf-security-shield.js" --test
  node "$ROOT_DIR/.agents/hooks/crusher-health-check.js" --test
fi
