{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "index.js",
    "bin/**/*.js",
    "scripts/**/*.js",
    ".agents/hooks/*.js",
    "examples/**/*.js",
    "test/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    ".tmp-*",
    ".agents.backup.*"
  ]
}
